# --- LLM API KEYS ---


# --- DATABASE ---
# If using local MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=investment_ai

# --- SERVER CONFIG ---
PORT=8000
LOG_LEVEL=INFO

# --- Scout & Risk Thresholds ---
MIN_ROE_THRESHOLD=15.0
MAX_DEBT_RATIO=1.5
MAX_HIGH_RISK_ALLOC=40.0

# --- RISK LIMITS ---
# Conservative
CONS_MAX_BETA=0.8
CONS_MAX_DRAWDOWN=15.0

# Moderate
MOD_MAX_BETA=1.1
MOD_MAX_DRAWDOWN=25.0

# Aggressive
AGG_MAX_BETA=1.5
AGG_MAX_DRAWDOWN=40.0

# General
MAX_CORRELATION=0.7