# --- LLM API KEYS ---


# --- DATABASE ---
# If using local MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=investment_ai

# --- SERVER CONFIG ---
PORT=8000
LOG_LEVEL=INFO

# --- Scout & Risk Thresholds ---
MIN_ROE_THRESHOLD=15.0
MAX_DEBT_RATIO=1.5
MAX_HIGH_RISK_ALLOC=40.0

# --- RISK LIMITS ---
# Conservative
CONS_MAX_BETA=0.8
CONS_MAX_DRAWDOWN=15.0

# Moderate
MOD_MAX_BETA=1.1
MOD_MAX_DRAWDOWN=25.0

# Aggressive
AGG_MAX_BETA=1.5
AGG_MAX_DRAWDOWN=40.0

# General
MAX_CORRELATION=0.7

# ============================================
# PERSONALIZATION SETTINGS
# ============================================
DEFAULT_LIQUIDITY_PCT=20.0          # Keep 20% as emergency fund
DEFAULT_MAX_ASSET_PCT=15.0          # Max 15% per asset
MIN_PORTFOLIO_ASSETS=5              # At least 5 assets
MAX_PORTFOLIO_ASSETS=10             # Max 10 assets

# ============================================
# PROFILING SETTINGS
# ============================================
DEFAULT_HORIZON_YEARS=10            # Default investment horizon
HIGH_DEBT_THRESHOLD=0.4             # 40% debt-to-income is concerning
CRITICAL_DEBT_THRESHOLD=0.6         # 60% debt-to-income is critical
MIN_EMERGENCY_MONTHS=3              # Minimum emergency fund
REC_EMERGENCY_MONTHS=6              # Recommended emergency fund

# ============================================
# ORCHESTRATOR SETTINGS
# ============================================
MAX_DEBATE_ITERATIONS=2             # Max debate loops
MIN_CONFIDENCE_APPROVE=0.85         # Auto-approve if confidence > 85%

